# REVIEW ONLY — do not load until parser review and the complete denial matrix are approved.
abi <abi/4.0>,
include <tunables/global>

profile dominion-gx10-gamefactory-executor flags=(attach_disconnected,mediate_deleted) {
  /sbin/docker-init ix,
  /usr/local/bin/node ix,
  /usr/bin/flock ix,
  /opt/dominion-sandbox/fd-launcher Px -> dominion-gx10-gamefactory-executor//&dominion-gx10-fd-launcher,
  /opt/dominion-payload/node Px -> dominion-gx10-gamefactory-executor//&dominion-gx10-fd-launcher//&dominion-gx10-payload-node,
  /opt/dominion-payload/godot Px -> dominion-gx10-gamefactory-executor//&dominion-gx10-fd-launcher//&dominion-gx10-payload-godot,

  /app/gx10-executor-entrypoint.mjs r,
  /app/gamefactory-executor.mjs r,
  /app/gamefactory-worker.mjs r,
  /app/gamefactory-ipc.mjs r,
  /lib/** mr,
  /usr/lib/** mr,
  /etc/ld.so.cache r,
  /etc/nsswitch.conf r,
  /etc/passwd r,
  /etc/group r,
  /dev/null rw,
  /dev/urandom r,

  /commands/ r,
  /commands/** r,
  /replies/ rw,
  /replies/** rwk,
  /workspace/ rw,
  /workspace/** rwk,
  /runtime/ rw,
  /runtime/payload/ rw,
  /runtime/payload/** rwk,
  /tmp/ rw,
  /tmp/** rwk,

  /opt/dominion-sandbox/fd-launcher r,
  /opt/dominion-sandbox/node-seccomp.bpf r,
  /opt/dominion-sandbox/godot-seccomp.bpf r,
  /opt/dominion-payload/node mr,
  /opt/dominion-payload/godot mr,
  /opt/dominion-payload/_sc_ r,
  /opt/dominion-payload/editor_data/ r,
  /opt/dominion-payload/editor_data/** r,
  /opt/dominion-canary/godot-profile-probe.gd r,
  /etc/fonts/ r,
  /etc/fonts/** r,
  /usr/share/fonts/ r,
  /usr/share/fonts/** r,
  /usr/share/fontconfig/ r,
  /usr/share/fontconfig/** r,
  /var/cache/fontconfig/ r,
  /var/cache/fontconfig/** r,
  /policy/executor.apparmor r,
  /policy/executor-seccomp.json r,

  /proc/self/mountinfo r,
  /proc/self/status r,
  /proc/self/attr/current r,
  /proc/net/dev r,
  /proc/net/route r,
  owner /proc/@{pid}/stat r,
  owner /proc/@{pid}/status r,
  owner /proc/@{pid}/cmdline r,
  owner /proc/@{pid}/comm r,
  owner /proc/@{pid}/fd/ r,
  owner /proc/@{pid}/fd/** r,
  owner /proc/@{pid}/fdinfo/ r,
  owner /proc/@{pid}/fdinfo/** r,
  owner /proc/@{pid}/attr/current r,
  /proc/sys/kernel/random/uuid r,
  /sys/devices/system/cpu/** r,

  signal (send, receive) peer=dominion-gx10-gamefactory-executor,
  signal (send) peer=dominion-gx10-gamefactory-executor//&dominion-gx10-fd-launcher,
  signal (send, receive) peer=dominion-gx10-gamefactory-executor//&dominion-gx10-fd-launcher//&dominion-gx10-payload-node,
  signal (send, receive) peer=dominion-gx10-gamefactory-executor//&dominion-gx10-fd-launcher//&dominion-gx10-payload-godot,
  deny network,
  deny capability,
  deny userns,
  deny mount,
  deny umount,
  deny pivot_root,
  deny ptrace,
  deny /run/docker.sock rwklmx,
  deny /var/run/docker.sock rwklmx,
  deny /etc/ssl/private/** r,
}

profile dominion-gx10-fd-launcher flags=(attach_disconnected,mediate_deleted) {
  /opt/dominion-sandbox/fd-launcher mr,
  /opt/dominion-payload/node Px -> dominion-gx10-gamefactory-executor//&dominion-gx10-fd-launcher//&dominion-gx10-payload-node,
  /opt/dominion-payload/godot Px -> dominion-gx10-gamefactory-executor//&dominion-gx10-fd-launcher//&dominion-gx10-payload-godot,
  /opt/dominion-payload/node mr,
  /opt/dominion-payload/godot mr,
  /opt/dominion-payload/_sc_ r,
  /opt/dominion-payload/editor_data/ r,
  /opt/dominion-payload/editor_data/** r,
  /opt/dominion-canary/godot-profile-probe.gd r,
  /lib/** mr,
  /usr/lib/** mr,
  /etc/ld.so.cache r,
  /etc/nsswitch.conf r,
  /etc/passwd r,
  /etc/group r,
  /etc/fonts/ r,
  /etc/fonts/** r,
  /usr/share/fonts/ r,
  /usr/share/fonts/** r,
  /usr/share/fontconfig/ r,
  /usr/share/fontconfig/** r,
  /var/cache/fontconfig/ r,
  /var/cache/fontconfig/** r,
  /dev/urandom r,
  /opt/dominion-sandbox/node-seccomp.bpf r,
  /opt/dominion-sandbox/godot-seccomp.bpf r,
  /workspace/ rw,
  /workspace/** rwk,
  /runtime/payload/ rw,
  /runtime/payload/** rwk,
  /proc/self/status r,
  /proc/self/attr/current r,
  /dev/null rw,
  signal (receive) peer=dominion-gx10-gamefactory-executor,
  signal (send, receive) peer=dominion-gx10-gamefactory-executor//&dominion-gx10-fd-launcher//&dominion-gx10-payload-node,
  signal (send, receive) peer=dominion-gx10-gamefactory-executor//&dominion-gx10-fd-launcher//&dominion-gx10-payload-godot,
  deny network,
  deny capability,
  deny userns,
  deny mount,
  deny umount,
  deny pivot_root,
  deny ptrace,
  deny /commands/** rwklmx,
  deny /replies/** rwklmx,
  deny /app/** rwklmx,
  deny /run/docker.sock rwklmx,
  deny /var/run/docker.sock rwklmx,
}

