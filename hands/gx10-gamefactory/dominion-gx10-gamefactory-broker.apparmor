  /etc/ssl/openssl.cnf r,
  /usr/lib/** mr,
  /usr/share/locale/** r,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-system-canary,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-system-canary//&dominion-gx10-payload-node-system-canary,
  signal (receive) peer=dominion-gx10-gamefactory-broker,
  ptrace (readby) peer=dominion-gx10-gamefactory-broker,
}

