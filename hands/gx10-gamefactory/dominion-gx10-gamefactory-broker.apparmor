# Direct static-broker profile. The broker is the explicit TCB and may retain workspace
# authority; every payload transition below names one fixed reviewed project subtree.
profile dominion-gx10-gamefactory-broker flags=(attach_disconnected,mediate_deleted) {
  deny network,
  deny capability,
  deny mount,
  deny umount,
  deny pivot_root,

  /opt/dominion-broker/launch-broker ix,
  /opt/dominion-broker/launch-broker r,
  /opt/dominion-broker/node-seccomp.bpf r,
  /opt/dominion-broker/godot-seccomp.bpf r,
  /opt/dominion-broker/node-guard r,
  /opt/dominion-broker/godot-guard r,
  /opt/dominion-broker/guards/ r,
  # One computed stacking transition avoids the kernel's per-profile named
  # transition limit while retaining a distinct, exact guard profile per project.
  # The attachment selects the guard; the relative stack target then intersects
  # that computed transition with the explicitly named broker profile. A bare
  # `-> &` parses but names a literal missing profile and therefore fails live.
  /opt/dominion-broker/guards/*-guard rpx -> &dominion-gx10-gamefactory-broker,

  /opt/dominion-payload/node mrix,
  /opt/dominion-payload/godot mrix,
  /opt/dominion-payload/** r,
  /opt/dominion-policy/* r,

  /broker-requests/ r,
  /broker-requests/** r,
  /broker-results/ rw,
  /broker-results/** rwk,
  /broker-state/ rw,
  /broker-state/** rwk,
  /workspace/ rw,
  /workspace/** rwk,
  /runtime/ rw,
  /runtime/** rwk,

  /dev/null rw,
  /dev/urandom r,
  /etc/ld.so.cache r,
  /etc/ssl/openssl.cnf r,
  /etc/fonts/ r,
  /etc/fonts/** r,
  /usr/lib/ r,
  /usr/lib/** mr,
  /usr/share/fonts/ r,
  /usr/share/fonts/** r,
  /usr/share/fontconfig/ r,
  /usr/share/fontconfig/** r,
  /usr/share/locale/ r,
  /usr/share/locale/** r,
  # glibc resolves the immutable container UTC localtime target on first timestamp formatting.
  /usr/share/zoneinfo/Etc/UTC r,
  /var/cache/fontconfig/ r,
  /var/cache/fontconfig/** r,

  /proc/self/attr/current r,
  /proc/self/cgroup r,
  /proc/self/mountinfo r,
  /proc/self/status r,
  /proc/sys/kernel/random/boot_id r,
  /proc/[0-9]*/attr/current r,
  /proc/[0-9]*/cgroup r,
  /proc/[0-9]*/exe r,
  /proc/[0-9]*/mountinfo r,
  /proc/[0-9]*/stat r,
  /proc/[0-9]*/status r,
  /proc/[0-9]*/ns/pid r,
  /sys/fs/cgroup/ r,
  /sys/fs/cgroup/** r,

  # PID1 must bind a freshly forked, not-yet-transitioned child to its exact
  # /proc identity before permitting the guard exec. Both sides still carry
  # this same broker label during that bounded handshake.
  ptrace (read,readby) peer=dominion-gx10-gamefactory-broker,
  ptrace (read) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-system-canary,
  ptrace (read) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-system-canary,
  ptrace (read) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-vector-vault,
  ptrace (read) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-vector-vault,
  ptrace (read) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-bolt-bloom,
  ptrace (read) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-bolt-bloom,
  ptrace (read) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-pocket-gravity,
  ptrace (read) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-pocket-gravity,
  ptrace (read) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-chromalock,
  ptrace (read) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-chromalock,
  ptrace (read) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-tiny-foundry,
  ptrace (read) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-tiny-foundry,
  ptrace (read) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-letter-loom,
  ptrace (read) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-letter-loom,
  ptrace (read) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-pulse-path,
  ptrace (read) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-pulse-path,
  ptrace (read) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-shelf-shift,
  ptrace (read) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-shelf-shift,
  ptrace (read) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-wobble-works,
  ptrace (read) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-wobble-works,
  ptrace (read) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-signal-grid,
  ptrace (read) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-signal-grid,

  # Docker/runc are host-trusted and unconfined. Permit only their TERM/KILL
  # delivery so the dedicated container can be stopped and restarted; grant
  # the broker no reciprocal signal authority over the host.
  signal (receive) set=(term kill) peer=unconfined,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-system-canary,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-system-canary,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-system-canary//&dominion-gx10-payload-node-system-canary,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-system-canary//&dominion-gx10-payload-godot-system-canary,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-vector-vault,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-vector-vault,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-vector-vault//&dominion-gx10-payload-node-vector-vault,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-vector-vault//&dominion-gx10-payload-godot-vector-vault,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-bolt-bloom,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-bolt-bloom,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-bolt-bloom//&dominion-gx10-payload-node-bolt-bloom,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-bolt-bloom//&dominion-gx10-payload-godot-bolt-bloom,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-pocket-gravity,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-pocket-gravity,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-pocket-gravity//&dominion-gx10-payload-node-pocket-gravity,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-pocket-gravity//&dominion-gx10-payload-godot-pocket-gravity,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-chromalock,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-chromalock,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-chromalock//&dominion-gx10-payload-node-chromalock,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-chromalock//&dominion-gx10-payload-godot-chromalock,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-tiny-foundry,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-tiny-foundry,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-tiny-foundry//&dominion-gx10-payload-node-tiny-foundry,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-tiny-foundry//&dominion-gx10-payload-godot-tiny-foundry,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-letter-loom,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-letter-loom,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-letter-loom//&dominion-gx10-payload-node-letter-loom,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-letter-loom//&dominion-gx10-payload-godot-letter-loom,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-pulse-path,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-pulse-path,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-pulse-path//&dominion-gx10-payload-node-pulse-path,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-pulse-path//&dominion-gx10-payload-godot-pulse-path,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-shelf-shift,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-shelf-shift,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-shelf-shift//&dominion-gx10-payload-node-shelf-shift,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-shelf-shift//&dominion-gx10-payload-godot-shelf-shift,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-wobble-works,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-wobble-works,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-wobble-works//&dominion-gx10-payload-node-wobble-works,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-wobble-works//&dominion-gx10-payload-godot-wobble-works,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-signal-grid,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-signal-grid,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-node-signal-grid//&dominion-gx10-payload-node-signal-grid,
  signal (send,receive) peer=dominion-gx10-gamefactory-broker//&dominion-gx10-guard-godot-signal-grid//&dominion-gx10-payload-godot-signal-grid,
}

