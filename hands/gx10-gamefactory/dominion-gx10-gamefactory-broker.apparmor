  deny /runtime/payload/active/pocket-gravity/** rwklmx,
  deny /runtime/payload/active/chromalock/ rwklmx,
  deny /runtime/payload/active/chromalock/** rwklmx,
  deny /runtime/payload/active/tiny-foundry/ rwklmx,
  deny /runtime/payload/active/tiny-foundry/** rwklmx,
  deny /runtime/payload/active/letter-loom/ rwklmx,
  deny /runtime/payload/active/letter-loom/** rwklmx,
  deny /runtime/payload/active/pulse-path/ rwklmx,
  deny /runtime/payload/active/pulse-path/** rwklmx,
  deny /runtime/payload/active/shelf-shift/ rwklmx,
  deny /runtime/payload/active/shelf-shift/** rwklmx,
