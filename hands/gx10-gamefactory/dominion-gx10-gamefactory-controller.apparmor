# REVIEW ONLY — do not load until the exact GX10 parser and denial plan are approved.
abi <abi/4.0>,

profile dominion-gx10-gamefactory-controller flags=(attach_disconnected,mediate_deleted) {
  /usr/local/bin/node ix,
  /app/ r,
  /app/gx10-controller-entrypoint.mjs r,
  /app/hands.mjs r,
  /app/snapshot.mjs r,
  /app/gamefactory-broker-controller.mjs r,
  /app/gamefactory-broker-protocol.mjs r,
  /app/gamefactory-broker-projects.mjs r,
  /app/gamefactory-ipc.mjs r,

  /lib/** mr,
  /usr/lib/** mr,
  /etc/ld.so.cache r,
  /etc/nsswitch.conf r,
  /etc/hosts r,
  /etc/resolv.conf r,
  /etc/ssl/certs/ r,
  /etc/ssl/certs/** r,
  /usr/share/ca-certificates/ r,
  /usr/share/ca-certificates/** r,
  deny /etc/ssl/private/** r,
  /dev/null rw,
  /dev/urandom r,

  /broker-requests/ rw,
  /broker-requests/** rwkl,
  link subset /broker-requests/** -> /broker-requests/**,
  /broker-results/ r,
  /broker-results/** r,
  /tmp/ rw,
  /tmp/** rwk,

  owner /proc/self/stat r,
  owner /proc/self/status r,
  owner /proc/self/cmdline r,
  owner /proc/self/fd/ r,
  owner /proc/self/fd/** r,
  owner /proc/self/fdinfo/ r,
  owner /proc/self/fdinfo/** r,
  owner /proc/self/attr/current r,
  /proc/self/mountinfo r,
  # Docker's procfs resolves /proc/self to the container PID before AppArmor mediation.
  # Owner qualification confines these numeric paths to controller-UID processes in this PID NS.
  owner /proc/[0-9]*/stat r,
  owner /proc/[0-9]*/status r,
  owner /proc/[0-9]*/cmdline r,
  owner /proc/[0-9]*/fd/ r,
  owner /proc/[0-9]*/fd/** r,
  owner /proc/[0-9]*/fdinfo/ r,
  owner /proc/[0-9]*/fdinfo/** r,
  owner /proc/[0-9]*/attr/current r,
  owner /proc/[0-9]*/mountinfo r,
  /proc/sys/kernel/random/uuid r,
  /sys/devices/system/cpu/** r,

  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,
  deny network unix,
  # Docker/runc need a narrowly bounded host-control path for safe lifecycle
  # operations. This grants receive-only TERM/KILL, never signals back to the
  # unconfined host.
  signal (receive) set=(term kill) peer=unconfined,
  signal (send, receive) peer=dominion-gx10-gamefactory-controller,

  deny capability,
  deny userns,
  deny mount,
  deny umount,
  deny pivot_root,
  deny ptrace,
  deny /workspace/** rwklmx,
  deny /runtime/** rwklmx,
  deny /state/** rwklmx,
  deny /run/docker.sock rwklmx,
  deny /var/run/docker.sock rwklmx,
  deny /proc/*/environ r,
  deny /proc/*/root/** r,
  deny /proc/*/cwd/** r,
  deny /proc/*/mem r,
  deny /proc/*/maps r,
}
