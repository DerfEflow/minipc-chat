# Copy values into a secret-aware container environment; do not commit the filled file.
# All host paths must already exist and be mutually non-overlapping. Commands are 10001:11000
# mode 2750; results are 10003:11000 mode 2750; broker-state/workspace/runtime are private to UID 10003.
# The setgid bit is required so every cross-UID spool file is GID 11000 and exact mode 0640.
# Android capability is disabled; no Android SDK/license layer is part of either production image.
HANDS_URL=https://app.dominion.tools
HANDS_TOKEN=<shared-secret>
GX10_NODE_IMAGE=node:24-bookworm-slim@sha256:e9b5516b06baeaea9a8e65a7aec6a85fbb960a30b52b66968f2c8092b3e2a3eb
GX10_GAME_FACTORY_CONTROLLER_SECCOMP_PROFILE=/etc/dominion-game-factory/seccomp-gx10-gamefactory-controller.json
GX10_GAME_FACTORY_BROKER_SECCOMP_PROFILE=/etc/dominion-game-factory/seccomp-gx10-gamefactory-broker.json
GX10_GAME_FACTORY_BROKER_APPARMOR_POLICY=/etc/dominion-game-factory/dominion-gx10-gamefactory-broker.apparmor
GX10_GAME_FACTORY_BROKER_DEPLOYMENT_POLICY=/etc/dominion-game-factory/gamefactory-broker-policy.bin
GX10_BROKER_BINARY_SHA256=<measured-static-broker-sha256>
GX10_NODE_GUARD_SHA256=<measured-static-node-guard-sha256>
GX10_GODOT_GUARD_SHA256=<measured-static-godot-guard-sha256>
GX10_NODE_SECCOMP_SHA256=<measured-node-default-deny-raw-bpf-sha256>
GX10_GODOT_SECCOMP_SHA256=<measured-godot-default-deny-raw-bpf-sha256>
GX10_PAYLOAD_NODE_SHA256=<measured-copied-payload-node-sha256>
GX10_PAYLOAD_GODOT_SHA256=<measured-copied-payload-godot-sha256>
GX10_BROKER_APPARMOR_SHA256=<reviewed-broker-apparmor-source-sha256>
GX10_BROKER_OUTER_SECCOMP_SHA256=<reviewed-broker-docker-seccomp-json-sha256>
GX10_BROKER_DEPLOYMENT_POLICY_SHA256=<reviewed-broker-policy-sha256>

# Conventional examples only. Resolve and verify the exact GX10 paths before use.
# These five paths must be roots of separately mounted, fixed-size ext4 loopback filesystems.
# Reviewed capacities are workspace=8GiB, runtime=1GiB, commands=128MiB, broker-state=256MiB,
# and results=1GiB. Every mount retains rw,noexec,nosuid,nodev; do not silently resize any image.
GX10_WORKSPACE_IMAGE=/srv/dominion-game-factory/workspace.ext4
GX10_RUNTIME_IMAGE=/srv/dominion-game-factory/runtime.ext4
GX10_COMMANDS_IMAGE=/srv/dominion-game-factory/commands.ext4
GX10_BROKER_STATE_IMAGE=/srv/dominion-game-factory/broker-state.ext4
GX10_RESULTS_IMAGE=/srv/dominion-game-factory/broker-results.ext4
GX10_GAME_FACTORY_WORKSPACE=/srv/dominion-game-factory/workspace-loop
GX10_GAME_FACTORY_RUNTIME=/srv/dominion-game-factory/runtime-loop
GX10_GAME_FACTORY_COMMANDS=/srv/dominion-game-factory/commands-loop
GX10_GAME_FACTORY_BROKER_STATE=/srv/dominion-game-factory/broker-state-loop
GX10_GAME_FACTORY_RESULTS=/srv/dominion-game-factory/broker-results-loop

# Safe canary defaults. Do not attest isolation/toolchains from intended configuration.
GAME_FACTORY_WORKER_ISOLATION_ATTESTED=0
GAME_FACTORY_WORKER_TOOLCHAIN_ATTESTED=0
GAME_FACTORY_WORKER_PROGRAMS=node,godot
GX10_GAME_FACTORY_CONTROLLER_CPUS=0.5
GX10_GAME_FACTORY_CONTROLLER_MEMORY=384m
GX10_GAME_FACTORY_BROKER_CPUS=2.0
GX10_GAME_FACTORY_BROKER_MEMORY=2g
